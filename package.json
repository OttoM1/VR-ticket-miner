{
  "name": "vr-ticket-miner",
  "version": "0.1.0",
  "description": "CLI tool to find the cheapest VR train tickets for a route across an entire week",
  "type": "module",
  "bin": {
    "vr-miner": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "search": "tsx src/cli/index.ts search",
    "check-bash": "bash bash/run_all.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "vr",
    "train",
    "tickets",
    "finland",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "axios": "^1.7.9",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "ora": "^8.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0"
  }
}
